# Essentia API (values are bundled into the client; do not commit real secrets)

VITE_ESSENTIA_API_BASE_URL=https://essentia.v1su4.dev

# Use either name (both are read by the app). Vite is configured with envPrefix ESSENTIA_
# so ESSENTIA_API_KEY is available as import.meta.env.ESSENTIA_API_KEY.
VITE_ESSENTIA_API_KEY=
ESSENTIA_API_KEY=

# If you deploy the Essentia service separately, its server may expect API_KEYS — not used by this Svelte app.
# API_KEYS=
